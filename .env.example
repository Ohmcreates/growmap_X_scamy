# ====================================================================
# Scam Spotter (Growmap x Scamy) — Environment Configuration
# ====================================================================

# --------------------------------------------------------------------
# 1. Supabase PostgreSQL Configuration for Prisma ORM
# Obtain these from: Supabase Dashboard > Project Settings > Database > Connection String
# --------------------------------------------------------------------
# Connection Pooling URL (Mode: Session or Transaction on port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection URL (For Prisma CLI migrations on port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# --------------------------------------------------------------------
# 2. Application Session Security
# --------------------------------------------------------------------
SECRET_KEY=scam-spotter-super-secret-key-change-in-production

# --------------------------------------------------------------------
# 3. Google Gemini AI API Key (Optional Cybersecurity Advisory)
# --------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------------------------------------------------
# 4. Frontend API Bridge (Set on Vercel to point to Render backend)
# --------------------------------------------------------------------
VITE_API_URL=https://your-render-backend.onrender.com
